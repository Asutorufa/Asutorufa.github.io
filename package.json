{
  "name": "asutorufa-react-blog",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run react:build",
    "build:full": "npm run react:build:full",
    "build:content": "npm run react:build:content",
    "analyze": "ANALYZE=true npm run react:build:full",
    "post:new": "node --import tsx tools/react-blog/new-post.ts",
    "prelint": "npm run react:generate",
    "lint": "eslint src tools/react-blog vite.config.mts",
    "prelint:fix": "npm run react:generate",
    "lint:fix": "eslint src tools/react-blog vite.config.mts --fix",
    "prereact:dev": "npm run react:generate",
    "react:dev": "vite --host 0.0.0.0",
    "react:generate": "node --import tsx tools/react-blog/generate-client-common.ts",
    "react:build": "node --import tsx tools/react-blog/build.ts",
    "react:build:full": "node --import tsx tools/react-blog/build.ts --full",
    "react:build:content": "node --import tsx tools/react-blog/build.ts --content-only",
    "react:preview": "node --import tsx tools/react-blog/dev.ts",
    "react:preview:static": "vite preview --outDir dist-react --host 0.0.0.0"
  },
  "dependencies": {
    "@renbaoshuo/markdown-it-katex": "^2.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "fast-glob": "^3.3.3",
    "katex": "^0.18.0",
    "lucide-react": "^1.42.0",
    "markdown-it": "^15.0.0",
    "mermaid": "^12.0.0",
    "motion": "^13.0.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.0",
    "vite": "^8.2.2",
    "wouter": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "agent-browser": "^0.37.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript-eslint": "^8.69.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
